# ---- Gemini（翻译用）----
# 拿 key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Notion ----
# 1. 建一个 integration：https://www.notion.so/my-integrations
# 2. 把下面两个数据库都 Share 给这个 integration，否则会 404
NOTION_TOKEN=

# 跑 scripts/bootstrap_notion.py 会帮你建这两张表并打印 id
NOTION_INFO_DB_ID=
NOTION_STOCK_DB_ID=

# 只在第一次跑 bootstrap 时需要：新建的两张表挂在哪个页面下
NOTION_PARENT_PAGE_ID=
